# Copy this file to .env and fill in the values.

# Required for the AI speaking partner and writing feedback.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Payments (optional until you want to charge). Without these, everyone gets free access.
# STRIPE_PRICE_ID is the monthly €149 price you create in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Your public address, e.g. https://lote.app (used for payment redirects).
PUBLIC_URL=

# Default meeting link for live classes (you can set one per class in Account → Admin).
LIVE_CLASS_URL=

# Optional tuning
# PORT=3001
# DATABASE_PATH=data/lote.db
# TRIAL_DAYS=7
# DAILY_AI_LIMIT=200
# PRICE_EUR=149
